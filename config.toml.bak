model = "gpt-5.5"
review_model = "gpt-5.5"
model_reasoning_effort = "high"
model_reasoning_summary = "auto"
model_verbosity = "low"
model_supports_reasoning_summaries = true
web_search = "live"
personality = "pragmatic"
approval_policy = "never"
sandbox_mode = "danger-full-access"


notify = ["/Users/yanunyang/.codex/computer-use/Codex Computer Use.app/Contents/SharedSupport/SkyComputerUseClient.app/Contents/MacOS/SkyComputerUseClient", "turn-ended", "--previous-notify", "[\"notify-send\",\"Codex\"]"]

[sandbox_workspace_write]
network_access = true

[[skills.config]]
path = "~/.codex/skills/.system/skill-creator/SKILL.md"
enabled = false

[[skills.config]]
path = "~/.codex/skills/.system/skill-installer/SKILL.md"
enabled = false

[[skills.config]]
path = "~/.codex/skills/.system/plugin-creator/SKILL.md"
enabled = false

[[skills.config]]
path = "~/.codex/skills/.system/imagegen/SKILL.md"
enabled = false

[[skills.config]]
path = "~/.codex/skills/skill-gemini-design/SKILL.md"
enabled = false

[tui]
status_line = [ "model-with-reasoning", "git-branch", "context-used", "five-hour-limit", "weekly-limit" ]

[tui.model_availability_nux]
"gpt-5.5" = 1

[features]
multi_agent = false
memories = false
chronicle = false

[agents]
max_threads = 3
max_depth = 1