{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-antigravity-auth@latest",
  ],
  "autoupdate": true,
  "permission": {
    "skill": {
      "*": "allow",
      "command-*": "deny",
    }
  },
  "agent": {
    "build": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high",
      "textVerbosity": "low"
    },
    "plan": {
      "model": "openai/gpt-5.4",
      "reasoningEffort": "high",
      "textVerbosity": "low"
    },
    "quick": {
      "model": "openai/gpt-5.3-codex-spark",
      "reasoningEffort": "high",
      "textVerbosity": "low"
    },
    "design": {
      "model": "google/gemini-3.1-pro-preview",
      "thinkingConfig": {
        "thinkingLevel": "low",
        "includeThoughts": true
      }
    }
  }
}